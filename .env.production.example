# AURA API production/staging example.
# Never commit real keys.

AURA_ENV=production
AURA_SIMPLIFIED_BRAIN=1
HOST=0.0.0.0
# Render provides PORT dynamically. Keep this only for local production smoke.
PORT=4000
APP_ORIGIN=*

# Launch persistence target. Local JSON is development-only on Render.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional distributed queue. Strongly recommended before public launch.
REDIS_URL=
REDIS_KEY_PREFIX=aura

# Brain providers.
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=z-ai/glm-4.5-air
OPENROUTER_FALLBACK_MODELS=google/gemini-flash-1.5
NVIDIA_API_KEYS=

# STT/TTS backend fallback keys are legacy only. Local mobile voice is the launch baseline.
GROQ_API_KEYS=
GEMINI_API_KEYS=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Sulafat
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536
POCKET_TTS_ENABLED=false

# API TTS. Keep secrets on the backend only; never put these in the IPA.
# Current experiments use Gemini or Orca TTS primary and iOS enhanced voice as mobile fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_OPTIMIZE_STREAMING_LATENCY=3
ELEVENLABS_MAX_REQUESTS_PER_MINUTE=30
PICOVOICE_ACCESS_KEY=
ORCA_DEFAULT_VOICE=male

DAILY_MESSAGE_LIMIT=100
BETA_DAILY_MESSAGE_LIMIT=100
BRAIN_MAX_CONCURRENCY=5
BRAIN_GLOBAL_MAX_CONCURRENCY=5
BRAIN_QUEUE_MAX_DEPTH=40
BRAIN_QUEUE_WAIT_MS=18000
